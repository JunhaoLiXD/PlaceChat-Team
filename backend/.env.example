# Copy to backend/.env and fill in values. Never commit real values.
ENVIRONMENT=local

# Supabase session pooler connection string (port 5432). Ask Junhao.
DATABASE_URL=

# Supabase project URL and secret key (sb_secret_...). Server only: never put the secret key in frontend code.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Product settings have defaults in app/core/config.py (PlaceChat Technical Design §11).
# Override one here only when testing, e.g. RATE_LIMIT_MAX_MESSAGES=100
