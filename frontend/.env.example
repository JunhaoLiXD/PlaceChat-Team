# Copy to .env.local and fill in values. Never commit real values.
# NEXT_PUBLIC_ variables are inlined into the browser bundle at build time.

# Base URL of the FastAPI backend (local: http://localhost:8000).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Use deterministic room data locally until the PBI-04 rooms API is available.
# Connected preview and staging deployments should set this to false.
NEXT_PUBLIC_USE_MOCKS=true

# Supabase project URL and publishable key (sb_publishable_...). Ask Junhao.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
